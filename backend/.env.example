# Django settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True

# MySQL Database
DB_NAME=vaulthub_db
DB_USER=root
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# AES-256-GCM Encryption Key (32 bytes = 64 hex chars)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
VAULT_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# Frontend Origin (for CORS)
FRONTEND_URL=http://localhost:3000
