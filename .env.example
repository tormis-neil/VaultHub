PORT=3000
NODE_ENV=development
VAULT_ENCRYPTION_KEY=super-secret-vault-master-key-2026-secure

# Optional: PostgreSQL Database Connection
# If left unset, VaultHub runs in zero-setup fallback mode with full in-memory AES-256-GCM encryption.
# If connecting to local PostgreSQL on your laptop:
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=your_password_here
SQL_DB_NAME=cloud_sql_development_database

# If connecting to Google Cloud SQL from your laptop, run the Cloud SQL Proxy:
# cloud-sql-proxy subtle-unison-vvr20:asia-southeast1:ai-studio-7f61e4e0 --port 5432
